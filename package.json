{
  "name": "postern",
  "private": true,
  "license": "MIT",
  "version": "0.5.9",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:bdd": "vitest run features/steps",
    "test:e2e": "playwright test --project=chromium",
    "test:e2e:live": "playwright test --config=playwright.live.config.ts",
    "shots": "playwright test --project=shots",
    "gate:shots": "npm run build && TZ=UTC playwright test --project=shots",
    "shots:publish": "node scripts/publish-shots.mjs",
    "typecheck": "tsc -b --noEmit",
    "fixture": "tsx scripts/generate-fixture.ts"
  },
  "dependencies": {
    "@bsv/sdk": "^2.2.0",
    "@scure/bip39": "^2.4.0",
    "bsv-kit": "github:Jonathan-A-White/bsv-kit#29230e0818449c76ae8ae630a858c68e4601ed97",
    "dexie": "^4.3.0",
    "mermaid": "^12.0.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "spell-forge-bsv": "https://github.com/Jonathan-A-White/spell-forge/releases/download/bsv-v0.1.0/spell-forge-bsv-0.1.0.tgz",
    "workbox-precaching": "7.4.1"
  },
  "devDependencies": {
    "@amiceli/vitest-cucumber": "7.0.0",
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.2.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "fake-indexeddb": "^6.2.5",
    "globals": "^16.5.0",
    "jsdom": "^28.1.0",
    "tailwindcss": "^4.2.1",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.0.18"
  },
  "allowScripts": {
    "github:Jonathan-A-White/bsv-kit#29230e0818449c76ae8ae630a858c68e4601ed97": true
  }
}
